# Optional: copy into Streamlit Community Cloud > App settings > Secrets.
# Leave secrets unset for an entirely offline demo. Never commit actual keys.
SERPAPI_KEY = ""
NESSIE_API_KEY = ""
GEMINI_API_KEY = ""
# Optional; leave blank to use the application default.
GEMINI_MODEL = ""

# Recommended for the hosted site: where accounts (email + password) and their saved trips live.
# Without these, accounts are kept in a local file on the server, which is wiped whenever the
# hosted app restarts or redeploys. Supabase > Project Settings > API:
#   SUPABASE_URL is the Project URL; SUPABASE_SERVICE_KEY is the secret (service_role) key.
# Run supabase_setup.sql once in the Supabase SQL Editor first.
SUPABASE_URL = ""
SUPABASE_SERVICE_KEY = ""

# Optional: adds a "Continue with Google" button on the Account page (email + password works
# without it). Remove this whole block if you don't use Google sign-in.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application),
# with this exact redirect URI added under "Authorized redirect URIs".
# Locally use redirect_uri = "http://localhost:8501/oauth2callback" (and add that URI too).
[auth]
redirect_uri = "https://farewell-hacktx.streamlit.app/oauth2callback"
cookie_secret = "a long random string, e.g. from: python -c \"import secrets; print(secrets.token_hex(32))\""
client_id = "....apps.googleusercontent.com"
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
