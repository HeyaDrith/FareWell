+def remove_pick(trip: dict, pick_id: str) -> None:
+    """Undo a pick (e.g. the user switches hotels): removes the purchase and its savings deposit."""
+    if trip["demo"]:
+        t = _demo_trip(trip)
+        t["picks"] = [p for p in t["picks"] if p["id"] != pick_id]
+        return
+    for dep in _deposits(trip):
+        if dep["for"] == pick_id:
+            _request("DELETE", f"/deposits/{dep['id']}")
+    _request("DELETE", f"/purchases/{pick_id}")
+
+
+def list_picks(trip: dict) -> list[dict]:
+    """Every pick, oldest first, each with how much it saved."""
+    if trip["demo"]:
+        return [dict(p) for p in _demo_trip(trip)["picks"]]
+    raw = _request("GET", f"/accounts/{trip['budget_id']}/purchases")
+    picks = [_normalize_purchase(p) for p in raw if p.get("status") != "cancelled"]
+    saved_by_pick: dict[str, float] = {}
+    for dep in _deposits(trip):
+        saved_by_pick[dep["for"]] = saved_by_pick.get(dep["for"], 0) + dep["amount"]
+    for p in picks:
+        p["saved"] = round(saved_by_pick.get(p["id"], 0.0), 2)
+    return picks
+
+
+def get_summary(trip: dict) -> dict:
+    """{"budget", "spent", "saved", "remaining", "final_total", "over_budget", "picks"}.
+
+    Totals are computed from the purchase/deposit lists rather than Nessie's account balances,
+    because Nessie can leave new transactions "pending" without updating the balance yet.
+    """
+    picks = list_picks(trip)
+    spent = round(sum(p["amount"] for p in picks), 2)
+    saved = round(sum(p["saved"] for p in picks), 2)
+    remaining = round(trip["budget"] - spent, 2)
+    return {"budget": trip["budget"], "spent": spent, "saved": saved, "remaining": remaining,
+            "final_total": spent, "over_budget": remaining < 0, "picks": picks}
+
+
+# ---------- internals ----------
+
+def _key() -> str:
+    return os.environ["NESSIE_API_KEY"]
+
+
+def _request(method: str, path: str, body: dict | None = None):
+    try:
+        r = requests.request(method, f"{BASE}{path}", params={"key": _key()}, json=body, timeout=15,
+                             allow_redirects=False)  # never resend the key to a redirect target
+    except requests.RequestException as e:
+        # Don't include str(e): it contains the request URL, which carries the API key.
+        raise BankError(f"Could not reach Nessie ({type(e).__name__}). Check your internet "
+                        "connection and try again.") from None
+    if r.status_code >= 400:
+        raise BankError(f"Nessie {method} {path} failed ({r.status_code}): {r.text[:200]}")
+    return r.json() if r.content else {}
+
+
+def _money(amount) -> float:
+    try:
+        value = round(float(amount), 2)
+    except (TypeError, ValueError):
+        raise BankError(f"Amount must be a number, got {amount!r}")
+    if value <= 0:
+        raise BankError("Amount must be greater than $0")
+    return value
+
+
+def _merchant_id(category: str) -> str:
+    """Get (or create once) the Nessie merchant used for this category."""
+    if category not in _MERCHANTS:
+        created = _request("POST", "/merchants", {
+            "name": f"Trip Saver {category}",
+            "category": category,
+            "address": {"street_number": "1", "street_name": "Congress Ave",
+                        "city": "Austin", "state": "TX", "zip": "78701"},
+            "geocode": {"lat": 30.2672, "lng": -97.7431},
+        })["objectCreated"]
+        _MERCHANTS[category] = created["_id"]
+    return _MERCHANTS[category]
+
+
+def _demo_trip(trip: dict) -> dict:
+    if trip["budget_id"] not in _DEMO:
+        raise BankError("Trip not found. Start a new trip.")
+    return _DEMO[trip["budget_id"]]
+
+
+def _deposits(trip: dict) -> list[dict]:
+    raw = _request("GET", f"/accounts/{trip['savings_id']}/deposits")
+    out = []
+    for d in raw:
+        m = _TAG.match(d.get("description", ""))
+        if m and d.get("status") != "cancelled":
+            out.append({"id": d.get("_id", ""), "for": m.group(1), "amount": float(d.get("amount", 0))})
+    return out
+
+
+def _normalize_purchase(p: dict) -> dict:
+    desc = p.get("description", "")
+    category = "Other"
+    if desc.startswith("[") and "]" in desc:
+        tag, desc = desc[1:].split("]", 1)
+        category = tag if tag in CATEGORIES else "Other"
+    return {"id": p.get("_id", ""), "category": category, "description": desc.strip(),
+            "amount": float(p.get("amount", 0)), "saved": 0.0, "date": p.get("purchase_date", "")}
